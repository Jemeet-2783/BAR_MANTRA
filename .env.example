# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password used to authenticate to the Admin Panel.
# Default is "barmantra123" if not configured.
ADMIN_PASSWORD="barmantra123"

# JWT_ACCESS_SECRET: Secret key for signing 15-minute access tokens.
# Must be a long, secure random string in production environments.
JWT_ACCESS_SECRET="barmantra_jwt_access_secret_key_2026_super_secure"

# JWT_REFRESH_SECRET: Secret key for signing 8-hour refresh tokens.
# Must be a long, secure random string in production environments.
JWT_REFRESH_SECRET="barmantra_jwt_refresh_secret_key_2026_super_secure"

# RAZORPAY PAYMENT GATEWAY (Optional - Local Sandbox active if absent)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxx"

# STRIPE PAYMENT GATEWAY (Optional)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"

# WHATSAPP BUSINESS NOTIFICATION API (Meta Graph API / Interakt)
# Optional - Sandbox simulated dispatch logged to console if absent
WHATSAPP_PHONE_NUMBER_ID="100654321098765"
WHATSAPP_ACCESS_TOKEN="EAAGxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_ADMIN_NUMBER="+919829012345"


